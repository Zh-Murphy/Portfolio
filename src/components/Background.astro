---
---

<canvas id="site-background" aria-hidden="true"></canvas>
<div class="site-vignette" aria-hidden="true"></div>

<script>
  import * as THREE from "three";

  const canvas = document.getElementById("site-background") as HTMLCanvasElement | null;
  if (!canvas) throw new Error("Background canvas missing");

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const renderer = new THREE.WebGLRenderer({
    canvas,
    antialias: false,
    alpha: false,
    powerPreference: "high-performance",
  });

  renderer.setClearColor(0x05030a, 1);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(46, 1, 0.1, 100);
  camera.position.set(0, 0, 8);

  const root = new THREE.Group();
  scene.add(root);

  const softTexture = (() => {
    const c = document.createElement("canvas");
    c.width = c.height = 128;
    const ctx = c.getContext("2d")!;
    const g = ctx.createRadialGradient(64,64,0,64,64,64);
    g.addColorStop(0, "rgba(255,255,255,1)");
    g.addColorStop(.14, "rgba(255,255,255,.92)");
    g.addColorStop(.45, "rgba(255,255,255,.25)");
    g.addColorStop(1, "rgba(255,255,255,0)");
    ctx.fillStyle = g;
    ctx.fillRect(0,0,128,128);
    return new THREE.CanvasTexture(c);
  })();

  const particles = 900;
  const positions = new Float32Array(particles * 3);
  const sizes = new Float32Array(particles);
  for (let i=0;i<particles;i++) {
    const r = 3.2 + Math.random()*8;
    const a = Math.random()*Math.PI*2;
    const b = Math.acos(2*Math.random()-1);
    const x = Math.sin(b)*Math.cos(a)*r;
    const y = Math.sin(b)*Math.sin(a)*r*.72;
    const z = Math.cos(b)*r;
    positions[i*3] = x;
    positions[i*3+1] = y;
    positions[i*3+2] = z;
    sizes[i] = 1.2 + Math.random()*2.8;
  }

  const pGeo = new THREE.BufferGeometry();
  pGeo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
  pGeo.setAttribute("aSize", new THREE.BufferAttribute(sizes, 1));
  const pMat = new THREE.PointsMaterial({
    map: softTexture,
    color: 0x9f7aff,
    size: .035,
    transparent: true,
    opacity: .34,
    depthWrite: false,
    blending: THREE.AdditiveBlending,
    sizeAttenuation: true,
  });
  const pointField = new THREE.Points(pGeo, pMat);
  root.add(pointField);

  const whiteField = pointField.clone();
  whiteField.material = pMat.clone();
  (whiteField.material as THREE.PointsMaterial).color.set(0xe9ddff);
  (whiteField.material as THREE.PointsMaterial).opacity = .16;
  whiteField.scale.setScalar(.62);
  root.add(whiteField);

  function ribbon(seed:number, color:number, opacity:number) {
    const pts: THREE.Vector3[] = [];
    for (let i=0;i<12;i++) {
      const t = i/11;
      pts.push(new THREE.Vector3(
        -6 + t*12,
        Math.sin(t*Math.PI*2 + seed)*1.4 + Math.sin(t*7 + seed)*.35,
        Math.cos(t*Math.PI*1.6 + seed)*1.7 - 1.2
      ));
    }
    const curve = new THREE.CatmullRomCurve3(pts);
    const geo = new THREE.TubeGeometry(curve, 90, .018, 6, false);
    const mat = new THREE.MeshBasicMaterial({
      color,
      transparent:true,
      opacity,
      depthWrite:false,
      blending:THREE.AdditiveBlending,
    });
    const mesh = new THREE.Mesh(geo, mat);
    mesh.rotation.x = seed*.4;
    mesh.rotation.y = seed*.2;
    root.add(mesh);
    return mesh;
  }

  const ribbonA = ribbon(.6, 0x9d63ff, .25);
  const ribbonB = ribbon(2.4, 0xf08abf, .11);
  ribbonB.scale.setScalar(.72);

  const glow = new THREE.Sprite(new THREE.SpriteMaterial({
    map: softTexture,
    color: 0x7f42ff,
    transparent:true,
    opacity:.11,
    depthWrite:false,
    blending:THREE.AdditiveBlending,
  }));
  glow.scale.set(9,9,1);
  glow.position.set(2.6, .7, -2);
  root.add(glow);

  let mx=0, my=0, tx=0, ty=0, scroll=0, targetScroll=0;
  window.addEventListener("pointermove", (e) => {
    tx = (e.clientX / window.innerWidth - .5) * 2;
    ty = (e.clientY / window.innerHeight - .5) * 2;
  }, {passive:true});
  window.addEventListener("scroll", () => {
    targetScroll = window.scrollY / Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
  }, {passive:true});

  function resize() {
    const w = window.innerWidth, h = window.innerHeight;
    renderer.setSize(w,h,false);
    camera.aspect = w/h;
    camera.updateProjectionMatrix();
  }
  resize();
  window.addEventListener("resize", resize);

  const clock = new THREE.Clock();
  function frame() {
    const t = clock.getElapsedTime();
    mx += (tx-mx)*.035;
    my += (ty-my)*.035;
    scroll += (targetScroll-scroll)*.035;

    root.rotation.y = mx*.035 + scroll*.18;
    root.rotation.x = my*.018 - scroll*.08;
    pointField.rotation.y += reduced ? 0 : .00018;
    whiteField.rotation.y -= reduced ? 0 : .00011;
    ribbonA.rotation.z = Math.sin(t*.16)*.08 + mx*.02;
    ribbonB.rotation.z = Math.cos(t*.12)*.06 - my*.018;
    glow.material.opacity = .08 + Math.sin(t*.5)*.02;

    renderer.render(scene,camera);
    if (!reduced) requestAnimationFrame(frame);
  }
  frame();
</script>
